# Dedicated Symphony database only. Runtime role must not be a shared superuser.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/symphony?pgbouncer=true"
# Available only to a controlled migration/import job, never browser-side.
DIRECT_URL="postgresql://MIGRATION_USER:PASSWORD@DIRECT_HOST:5432/symphony"
APP_ORIGIN="http://localhost:3000"
QUESTION_INTAKE_ENABLED="false"
RELEASE_SHA="development"
