{
  "name": "peerivo-symphony",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/prepare-standalone.mjs",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:deploy:production": "prisma migrate deploy",
    "ingest:json": "node scripts/ingest-json.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.mjs tests/*.test.ts",
    "test:e2e": "playwright test",
    "seed:publish": "node scripts/publish-seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "6.12.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
