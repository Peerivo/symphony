# Dedicated Symphony database only. Runtime role must not be a shared superuser.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/symphony?pgbouncer=true"
# Runtime DIRECT_URL must carry the same restricted role, not migration credentials.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/symphony"
# Migration credentials belong only to the separately authorized migration runner.
APP_ORIGIN="http://localhost:3000"
QUESTION_INTAKE_ENABLED="false"
# Optional runtime attestation; if supplied, must match the embedded build revision.
RELEASE_SHA="EXACT_40_CHARACTER_GIT_SHA"
