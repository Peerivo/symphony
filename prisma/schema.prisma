// M1 conceptual Prisma schema. Extend via migrations; production deploys migrations through GitHub Actions.
generator client {\n  provider = "prisma-client-js"\n}
datasource db {\n  provider  = "postgresql"\n  url       = env("DATABASE_URL")\n  directUrl = env("DIRECT_URL")\n}

enum RightsStatus {\n  UNKNOWN\n  PUBLIC_DOMAIN\n  LICENSED\n  PERMISSION_GRANTED\n  LINK_ONLY\n  RESTRICTED\n}
enum SourceKind {\n  SCRIPTURE\n  PATRISTIC\n  WORK\n  COUNCIL\n  LITURGICAL\n  COMMENTARY\n  CONFESSIONAL\n  TAFSIR\n  HADITH\n  ARTICLE\n  BOOK\n  USER_QUESTION\n  OTHER\n}
enum LinkKind {\n  INTERPRETS\n  SUPPORTS\n  OPPOSES\n  PARALLEL_TO\n  REFERENCES\n  ABOUT\n  ANSWERS\n  RELATED_TO\n}

model Tradition {
  id String @id @default(cuid())
  name String @unique
  schools School[]
  authors Author[]
  interpretations Interpretation[]
  claims Claim[]
}
model School {
  id String @id @default(cuid())
  name String
  traditionId String
  tradition Tradition @relation(fields:[traditionId], references:[id])
  @@unique([traditionId,name])
}
model Author {
  id String @id @default(cuid())
  name String
  traditionId String?
  tradition Tradition? @relation(fields:[traditionId], references:[id])
  works Work[]
}
model Source {
  id String @id @default(cuid())
  name String
  kind SourceKind
  canonicalUrl String?
  rightsStatus RightsStatus @default(UNKNOWN)
  rightsEvidence String?
  license String?
  fetchedAt DateTime?
  checksum String?
  parserVersion String?
  works Work[]
}
model Work {
  id String @id @default(cuid())
  title String
  authorId String?
  sourceId String
  language String?
  author Author? @relation(fields:[authorId], references:[id])
  source Source @relation(fields:[sourceId], references:[id])
  sections WorkSection[]
}
model WorkSection {
  id String @id @default(cuid())
  workId String
  parentId String?
  ordinal Int
  heading String?
  text String @db.Text
  locator String?
  work Work @relation(fields:[workId], references:[id], onDelete:Cascade)
  parent WorkSection? @relation("SectionTree", fields:[parentId], references:[id])
  children WorkSection[] @relation("SectionTree")
  interpretations Interpretation[]
  @@index([workId,ordinal])
}
model Verse {
  id String @id @default(cuid())
  osis String @unique
  book String
  chapter Int
  verse Int
  text String @db.Text
  interpretations Interpretation[]
  questionLinks QuestionVerse[]
  @@index([book,chapter,verse])
}
model Interpretation {
  id String @id @default(cuid())
  verseId String?
  sectionId String
  traditionId String?
  summary String? @db.Text
  verse Verse? @relation(fields:[verseId], references:[id])
  section WorkSection @relation(fields:[sectionId], references:[id])
  tradition Tradition? @relation(fields:[traditionId], references:[id])
  @@index([verseId])
}
model Question {
  id String @id @default(cuid())
  canonicalText String @db.Text
  normalizedKey String @unique
  createdAt DateTime @default(now())
  verses QuestionVerse[]
  signals PopularitySignal[]
}
model QuestionVerse {
  questionId String
  verseId String
  relevance Float @default(1)
  question Question @relation(fields:[questionId], references:[id], onDelete:Cascade)
  verse Verse @relation(fields:[verseId], references:[id], onDelete:Cascade)
  @@id([questionId,verseId])
}
model Claim {
  id String @id @default(cuid())
  text String @db.Text
  traditionId String?
  sourceSectionId String?
  tradition Tradition? @relation(fields:[traditionId], references:[id])
}
model KnowledgeLink {
  id String @id @default(cuid())
  fromType String
  fromId String
  toType String
  toId String
  kind LinkKind
  weight Float @default(1)
  evidence String? @db.Text
  @@index([fromType,fromId])
  @@index([toType,toId])
}
model PopularitySignal {
  id String @id @default(cuid())
  questionId String
  bucket DateTime
  count Int @default(1)
  question Question @relation(fields:[questionId], references:[id], onDelete:Cascade)
  @@unique([questionId,bucket])
}
